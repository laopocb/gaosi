{
  "name": "local-gaussian-viewer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "本地 3D 高斯查看器：基于官方 SuperSplat Viewer 引擎，在浏览器中展示本地 .sog 数据，并处理 Z-up → Y-up 坐标系翻转。",
  "scripts": {
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "start": "node scripts/build.mjs && node scripts/serve.mjs"
  },
  "dependencies": {
    "@playcanvas/supersplat-viewer": "1.28.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
